# fpga.yaml — OpenFPGA Deck project
name: Apple_TN20K
board: tang-nano-20k
top: top

sources:
  - src/cpu/ALU.v
  - src/cpu/cpu_65c02.v
  - src/clk_gen.v
  - src/apple2_mem.v
  - src/sdram/sdram.v
  - src/aux_ram.v
  - src/slot_bus.v
  - src/disk2/disk2_card.v
  - src/disk2/disk2_store.v
  - src/prodos/prodos_card.v
  - src/sd/spi_byte.v
  - src/sd/sd_blk.v
  - src/sd/fat32.v
  - src/sd/sd_files.v
  - src/uart_tx.v
  - src/apple2_core.v
  - src/video_generator.v
  - src/colorbar_gen.v
  - src/input_controller.v
  - src/sound_generator.v
  - src/serial_debugger.v
  - src/hdmi/hdmi_tmds_encoder.v
  - src/hdmi/hdmi_packet_ecc.v
  - src/hdmi/hdmi_packets.v
  - src/hdmi/hdmi_data_island.v
  - src/hdmi/hdmi_island_scheduler.v
  - src/hdmi/hdmi_tx.v
  - src/top.v

# The raw SD FAT32 test bitstream (scripts/build.ps1 -Top sdtest): no Apple core
sdtest_sources:
  - src/sd/spi_byte.v
  - src/sd/sd_blk.v
  - src/sd/fat32.v
  - src/uart_tx.v
  - src/sdtest/fat_test.v
  - src/sdtest/top_sdtest.v

constraints:
  - constraints/top.cst
