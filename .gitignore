# Build outputs (bitstreams, netlists, logs)
/build/

# Apple //e ROM images are Apple copyright and must not be committed.
# See roms/README.md for how to supply them.
/roms/*.hex
/roms/*.bin
/roms/*.rom

# Simulation / lint artifacts
*.vcd
*.fst
*.vvp
obj_dir/

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
*:Zone.Identifier

# Web front end (see web/README.md)
/web/node_modules/
/web/dist/
# Built from roms/apple2e_char.hex, which is Apple copyright, same as above
/web/src/generated/charset.json

# Dev screenshots (they render the Apple character set)
*.png
/web/*.png
# Third-party vendor PDFs (datasheet, schematic) are not ours to redistribute
/Documents/*.pdf

# Python bytecode
__pycache__/

# Gowin IDE project, regenerated by scripts/build.ps1 (impl/ is its output)
/impl/
/*.gprj
*.gprj.user

# Logs
*.log

# AI tooling artifacts (kept local, never committed)
CLAUDE.md
.claude/
.agents/
.jules/

# Scratch directory
/scratch/
